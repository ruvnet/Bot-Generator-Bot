{
  "name": "bot-generator-bot-agent",
  "version": "0.1.0",
  "description": "Maintain and validate Bot-Generator-Bot",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bot-generator-bot-agent": "bin/cli.js"
  },
  "files": [
    "bin/**",
    "dist/**",
    "src/**",
    "tsconfig.json",
    ".claude/**",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "init": "node ./bin/cli.js init",
    "doctor": "node ./bin/cli.js doctor",
    "evolve": "metaharness-darwin evolve . --sandbox real --generations 3 --children 4",
    "evolve:dry": "metaharness-darwin evolve . --sandbox mock --generations 2 --children 3",
    "bench:generate": "metaharness-darwin bench create ../.. --out bench.generated.json",
    "bench:verify": "metaharness-darwin bench verify bench.generated.json",
    "verify:review": "node bin/verify-review.mjs"
  },
  "dependencies": {
    "@metaharness/kernel": "0.1.3",
    "@metaharness/host-codex": "0.1.2",
    "@metaharness/host-claude-code": "0.1.2",
    "@metaharness/host-copilot": "0.1.2",
    "@metaharness/field-memory": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@metaharness/darwin": "0.10.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
